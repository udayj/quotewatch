# Monitored Gmail account. QuoteWatch requests gmail.readonly for this account.
GMAIL_ACCOUNT=sales@company.example
GMAIL_TOKEN_JSON=

# Optional report delivery. Leave REPORT_EMAIL_TO empty to print reports only.
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=reports@company.example
REPORT_EMAIL_FROM_NAME=QuoteWatch
REPORT_EMAIL_TOKEN=report_token.json
REPORT_EMAIL_TOKEN_JSON=

# Supply one OAuth client source: JSON, an ID/secret pair, or client_secret.json.
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_AUTH_URI=
GOOGLE_OAUTH_TOKEN_URI=

# Copy the generic example to this ignored path, then adapt it for your workflow.
CLASSIFICATION_PROMPT_FILE=.classification_prompt.txt
CLASSIFIER_PROVIDER=fireworks

# Fireworks configuration. FIREWORKS_API_KEY is required for this provider.
FIREWORKS_API_KEY=
# FIREWORKS_MODEL=provider/model-name
FIREWORKS_INPUT_USD_PER_1M=0
FIREWORKS_CACHED_INPUT_USD_PER_1M=0
FIREWORKS_OUTPUT_USD_PER_1M=0

# Anthropic configuration. ANTHROPIC_API_KEY is required when using Claude.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=model-name
CLAUDE_INPUT_USD_PER_1M=0
CLAUDE_CACHE_WRITE_USD_PER_1M=0
CLAUDE_CACHE_READ_USD_PER_1M=0
CLAUDE_OUTPUT_USD_PER_1M=0

# Set a current conversion rate to include the existing INR cost estimate.
USD_TO_INR=0

# Leave DATABASE_URL empty to use the local --db path.
DATABASE_URL=
TURSO_AUTH_TOKEN=

# Base64-encoded 32-byte key; enables encrypted OAuth-token storage in the DB.
OAUTH_TOKEN_ENCRYPTION_KEY=
